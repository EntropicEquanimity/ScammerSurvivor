{
  "name": "scammer-survivor",
  "version": "0.1.0",
  "private": true,
  "description": "Scammer Survivor: a scam-awareness practice phone.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"web/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check": "node scripts/run-check.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^2.30.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
